# ADAPTIFY AI Environment Configuration Template
# Copy this file to .env and optionally add your API keys below:

# Optional: Google Gemini API Key (Built-in high-fidelity academic engine operates without this)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Wispr Flow Cloud API Key (Browser speech input fallback & system dictation operate without this)
WISPR_FLOW_API_KEY=
WISPR_FLOW_API_URL=https://platform-api.wisprflow.ai/api/v1/dash/api

# Security Key for Local JWT Sessions
SECRET_KEY=adaptify-ai-production-super-secret-key-2026
